{
  "compilerOptions": {
    "lib": ["es2022"],
    "types": ["mocha", "node"],
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "target": "es6",
    "outDir": "dist"
  },
  "include": ["index.js", "index.cts", "test/**/*.js"],
  "exclude": ["node_modules"]
}
